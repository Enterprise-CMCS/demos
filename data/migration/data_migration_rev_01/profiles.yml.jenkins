data_migration_rev_01:
  target: prod
  outputs:
    prod:
      type: postgres
      host: "{{ env_var('DEMOS_PGSQL_HOST') }}"
      port: "{{ env_var('DEMOS_PGSQL_PORT') | int }}"
      user: "{{ env_var('DEMOS_PGSQL_USER') }}"
      password: "{{ env_var('DEMOS_PGSQL_PWD') }}"
      dbname: "{{ env_var('DEMOS_PGSQL_DB') }}"
      schema: "{{ env_var('REV01_SCHEMA') }}"
      threads: 2
