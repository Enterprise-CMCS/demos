// Flags: NO_HISTORY
// Budget Neutrality CAP flags are replaceable snapshots derived from the uploaded workbook.
model BudgetNeutralityWorkbookHypotheticalYear {
  workbookId     String   @map("workbook_id") @db.Uuid
  hypotheticalId String   @map("hypothetical_id")
  dyNumber       Int      @map("dy_number")
  capNeeded      Boolean? @map("cap_needed")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  workbook     BudgetNeutralityWorkbook     @relation(fields: [workbookId], references: [id], onDelete: Cascade)
  hypothetical BudgetNeutralityHypothetical @relation(fields: [hypotheticalId], references: [hypotheticalId], onDelete: Restrict, onUpdate: Cascade)

  @@id([workbookId, hypotheticalId, dyNumber])
  @@map("budget_neutrality_workbook_hypothetical_year")
}
