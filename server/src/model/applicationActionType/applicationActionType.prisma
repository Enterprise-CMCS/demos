// Flags: STATIC_CONSTRAINT
model ApplicationActionType {
  id                       String
  shouldHaveUserId         Boolean @map("should_have_user_id")
  shouldHaveDateTypeId     Boolean @map("should_have_date_type_id")
  shouldHaveNoteTypeId     Boolean @map("should_have_note_type_id")
  shouldHaveDocumentTypeId Boolean @map("should_have_document_type_id")

  applicationActions ApplicationAction[]

  @@id([id])
  @@unique([id, shouldHaveUserId, shouldHaveDateTypeId, shouldHaveNoteTypeId, shouldHaveDocumentTypeId])
  @@map("application_action_type")
}
