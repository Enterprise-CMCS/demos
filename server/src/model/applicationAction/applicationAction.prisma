// Flags: NO_CREATED_TS, NO_UPDATED_TS
// Time is captured by the action timestamp; table is intended to be append-only
model ApplicationAction {
  id                   String   @default(uuid()) @db.Uuid
  actionTimestamp      DateTime @map("action_timestamp") @db.Timestamptz
  applicationId        String   @map("application_id") @db.Uuid
  actionTypeId         String   @map("action_type_id")
  dateTypeId           String?  @map("date_type_id")
  shouldHaveUserId     Boolean  @map("should_have_user_id")
  shouldHaveDateTypeId Boolean  @map("should_have_date_type_id")
  userId               String?  @map("user_id") @db.Uuid

  application Application           @relation(fields: [applicationId], references: [id])
  user        User?                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  dateType    DateType?             @relation(fields: [dateTypeId], references: [id])
  actionType  ApplicationActionType @relation(fields: [actionTypeId, shouldHaveUserId, shouldHaveDateTypeId], references: [id, shouldHaveUserId, shouldHaveDateTypeId])

  @@id([id])
  @@unique([id, actionTypeId])
  @@map("application_action")
}
