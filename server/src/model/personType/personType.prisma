model PersonType {
  id String

  people                                            Person[]
  rolePersonTypes                                   RolePersonType[]
  userPersonTypeLimit                               UserPersonTypeLimit[]
  cmsUserPersonTypeLimit                            CmsUserPersonTypeLimit[]
  DeliverableOwnerPersonTypeLimit                   DeliverableOwnerPersonTypeLimit[]
  primaryDemonstrationRoleAssignmentPersonTypeLimit PrimaryDemonstrationRoleAssignmentPersonTypeLimit[]

  @@id([id])
  @@map("person_type")
}
