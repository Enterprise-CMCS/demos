model EmailNotificationHistory {
  revisionId               Int          @id @default(autoincrement()) @map("revision_id")
  revisionType             RevisionType @map("revision_type")
  modifiedAt               DateTime     @default(now()) @map("modified_at") @db.Timestamptz
  id                       String       @db.Uuid
  emailTypeId              String       @map("email_type_id")
  entityType               String       @map("entity_type")
  deliverableId            String?      @map("deliverable_id") @db.Uuid
  applicationId            String?      @map("application_id") @db.Uuid
  applicationTypeId        String?      @map("application_type_id")
  referenceConfigurationId String?      @map("reference_configuration_id") @db.Uuid
  deliverableActionId      String?      @map("deliverable_action_id") @db.Uuid
  publicCommentId          String?      @map("public_comment_id") @db.Uuid
  statusId                 String       @map("status_id")
  payload                  Json
  sqsMessageId             String?      @map("sqs_message_id")
  lastError                String?      @map("last_error")
  createdAt                DateTime     @map("created_at") @db.Timestamptz
  updatedAt                DateTime     @map("updated_at") @db.Timestamptz

  @@map("email_notification_history")
}
