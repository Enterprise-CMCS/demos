pipeline {
  agent {
    kubernetes {
      yaml podSpec('node')
    }
  }

  options {
    disableConcurrentBuilds()
  }

  environment {
    NO_COLOR = 1
  }

  stages {
    stage('Install shared library deps') {
      steps {
        dirCon('shared_library', 'node') {
          sh 'npm ci'
        }
      }
    }

    stage('Check for updates') {
      steps {
        script {
          npmUpdates(dir: 'shared_library')
          npmUpdates(dir: 'client')
          npmUpdates(dir: 'server')
          npmUpdates(dir: 'deployment')
          npmUpdates(group: 'lambdas', dir: [
            'lambdas/authorizer',
            'lambdas/dbRoleManagement',
            'lambdas/emailer',
            'lambdas/emailScheduler',
            'lambdas/fileprocess',
            'lambdas/deleteinfectedfile',
            'lambdas/UIPath',
            'lambdas/budgetNeutrality',
            'lambdas/dataConnectExport'
          ])
        }
      }
    }
  }
}
