def advisoryFailures = []

pipeline {
  agent {
    kubernetes {
      yaml kubeBlock(containerNames:["node", "aws-cli", "snyk"])
    }
  }

  options {
    disableConcurrentBuilds()
    buildDiscarder(retentionPolicy("tag-deploy"))
    skipDefaultCheckout(true)
  }

  

  parameters {
    choice(name: 'ENVIRONMENT', choices: ['dev', 'test', 'jesse'], description: 'Select the environment') // Add prod and impl before merge
    string(name: 'RELEASE_TAG', trim: true, description: 'Release tag to deploy')
  }

  environment {
    NO_COLOR = 1
    STAGE = "${params.ENVIRONMENT}"
  }

  stages {
    stage('Checkout release tag') {
      steps {
        script {
          checkout([
            $class: 'GitSCM',
            branches: [[name: "refs/tags/${params.RELEASE_TAG}"]],
            userRemoteConfigs: [[
              credentialsId: 'demos-git-svc-account', 
              url: "https://github.com/Enterprise-CMCS/demos.git",
              refspec: '+refs/tags/*:refs/tags/*'
            ]]
          ])

          env.RELEASE_COMMIT = sh(script: 'git rev-parse --verify "HEAD^{commit}"', returnStdout: true).trim()
          echo "Checked out release tag ${params.RELEASE_TAG} at commit ${env.RELEASE_COMMIT}"
        }
      }
    }

    stage('Builds') {
      steps {
        script {
          echo "skip"
          // assumeRole(accountEnv: env.STAGE)
          // dirCon('deployment', 'node') {
          //   sh """
          //   mkdir ../shared_library/dist
          //   mkdir ../client/dist
          //   mkdir ../server/build

          //   # These are needed for the built-in CDK bundling
          //   apk add bash
          //   npm i -g esbuild
          //   npm i -g tsx

          //   # Ensure shared_library is installed and built before building client and server
          //   cd ../shared_library
          //   npm ci
          //   npm run build
          //   cd ../deployment

          //   npm ci
          //   npx tsx demosctl/index deploy:core ${env.STAGE}
          //   """
          // }
          // parallel(
          //   'Build Client': {
          //     dirCon('deployment','node') {
          //       sh "npx tsx demosctl/index build:client ${env.STAGE}"                                          
          //     }
          //   }, 
          //   'Build Server': {
          //     dirCon('deployment', 'node') {
          //       sh "npx tsx demosctl/index build:server ${env.STAGE}"
          //     }
          //   }
          // )
        }
      }
    }

    stage('Diff') {
      steps {
        script {
          dirCon('deployment','node') {
            echo "skip"
            // sh """
            // export UI_COMMIT_HASH=${env.RELEASE_COMMIT}
            // export API_COMMIT_HASH=${env.RELEASE_COMMIT}
            // npx cdk diff --context stage=${env.STAGE}
            // """
          }
        }
      }
    }

    stage('Approval') {
      steps {
        script {
          def approval
          
          while (true) {
            approval = input(
              message: "Deploy ${params.RELEASE_TAG} to ${params.ENVIRONMENT}?",
              ok: "Approve",
              cancel: "Reject",
              submitter: 'demos-prod-approvers',//params.ENVIRONMENT == 'prod' ? 'prod-approvers' : 'non-prod-approvers',
              submitterParameter: 'APPROVED_BY',
              parameters: [
                string(
                  name: 'JIRA_TICKET',
                  description: 'Jira ticket number (optional, required for PROD) e.g. DEMOS-1234',
                  trim: true
                ),
                string(
                  name: 'CONFIRM_ENVIRONMENT',
                  description: "Type ${params.ENVIRONMENT} to confirm the target environment",
                  trim: true
                ),
                string(
                  name: 'CONFIRM_TAG',
                  description: "Type ${params.RELEASE_TAG} to confirm the target tag (commit: ${env.RELEASE_COMMIT})",
                  trim: true
                ),
                booleanParam(
                  name: 'I_REVIEWED_CHANGE_SET',
                  defaultValue: false,
                  description: 'I reviewed the approval summary and raw change set'
                )
              ]
            )

            def errors = []

            if (approval.JIRA_TICKET != '' && !(approval.JIRA_TICKET ==~ /DEMOS-\d+/)) {
              errors << "Invalid Jira ticket: ${approval.JIRA_TICKET}"
            }

            if (params.ENVIRONMENT == 'prod' && approval.JIRA_TICKET == '') {
              errors << "Jira ticket is required for PROD deployments"
            } else if (approval.JIRA_TICKET == '') {
              echo "No jira ticket provided or required for ${params.ENVIRONMENT} deployment"
            }

            if (approval.CONFIRM_TAG != params.RELEASE_TAG) {
              errors << "Tag confirmation did not match. Expected: ${params.RELEASE_TAG}, got: ${approval.CONFIRM_TAG}"
            }

            if (approval.CONFIRM_ENVIRONMENT != params.ENVIRONMENT) {
              errors << "Environment confirmation did not match. Expected: ${params.ENVIRONMENT}, got: ${approval.CONFIRM_ENVIRONMENT}"
            }

            if (!approval.I_REVIEWED_CHANGE_SET) {
              errors << "Reviewer did not confirm change-set review"
            }

            if (errors.isEmpty()) {
              break
            } else {
              echo "Approval failed:\n- ${errors.join('\n- ')}"
              echo "Please try again."
            }
          }

          def jiraBody = """h3. Deployment Pipeline Approved

*Approved by:* [~${approval.APPROVED_BY.toUpperCase()}]
*Environment:* ${params.ENVIRONMENT}
*Release Tag:* ${params.RELEASE_TAG}
*Commit Hash:* ${env.RELEASE_COMMIT}
*Jenkins build:* ${env.BUILD_URL ?: env.JOB_NAME}
(Jenkins build logs expire after 30 days, so link may not be available)
"""
          if (approval.JIRA_TICKET != '') {
            try {
              echo "Updating Jira ticket ${approval.JIRA_TICKET} with deployment information"
              jiraComment(approval.JIRA_TICKET, jiraBody)
              env.JIRA_TICKET = approval.JIRA_TICKET
            } catch (err) {
              error err.getMessage()
            }
          } else {
            echo jiraBody
          }

        }
      }
    }

    

    stage("Run Migrations") {
      when {
        expression {
          params.ENVIRONMENT in ['dev', 'test', 'impl', 'prod']
        }
      }
      steps {
        script {
          dirCon('deployment', 'node') {
            echo "running migrations for ${env.STAGE}"
            // sh """
            // npx tsx demosctl/index migrate ${env.STAGE}
            // """
          }
        }
      }
      post {
        failure {
          script {            
            // notifyMigrationError(env.STAGE)
            echo "There was a migration error"
          }
        }
      }
    }

    stage('Deploy') {
      // npx tsx demosctl/index deploy:all ${env.STAGE}
      steps {
        script {
          dirCon('deployment','node') {
            echo "skip"
            // sh """
            // export UI_COMMIT_HASH=${env.RELEASE_COMMIT}
            // export API_COMMIT_HASH=${env.RELEASE_COMMIT}
            // npx cdk diff --context stage=${env.STAGE}
            // """
          }
        }
      }
    }

    stage('Record Deployed Release') {
      steps {
        script {
          if (env.JIRA_TICKET) {
            try {
              echo "Updating Jira ticket ${env.JIRA_TICKET} with deployment completion information"
              jiraComment(env.JIRA_TICKET, "Deployment of release tag ${params.RELEASE_TAG} to ${params.ENVIRONMENT} completed successfully.\n\nJenkins build: ${env.BUILD_URL ?: env.JOB_NAME}")
            } catch (err) {
              error err.getMessage()
            }
          } else {
            echo "No Jira ticket provided, skipping recording of deployed release"
          }
        }
      }
    }

    stage('Setting new Snyk Monitor') {
      when {
        expression {
          params.ENVIRONMENT == 'prod'
        }
      }
      steps {
        script {
          container("snyk") {
            withCredentials([
              string(credentialsId: 'demos-snyk-sa', variable: 'SNYK_TOKEN'),
              string(credentialsId: 'demos-snyk-org-id', variable: 'SNYK_CFG_ORG')
            ]) {
              // TODO: add all projects that run in PROD
              dir('server') {
                sh """
                  snyk monitor --project-name=prod-server --target-reference=${params.RELEASE_TAG} --remote-repo-url=https://github.com/Enterprise-CMCS/demos
                """
              }
              dir('client') {
                sh """
                  snyk monitor --project-name=prod-client --target-reference=${params.RELEASE_TAG} --remote-repo-url=https://github.com/Enterprise-CMCS/demos
                """
              }
            }
          }
        }
      }
    }
  }

  post {
    // success {
    //   script {
    //     if (advisoryFailures) {
    //       def advisoryText = advisoryFailures.findAll { it }.collect { "- ${it}" }.join("\n")
    //       slackSend(color: "warning", message: "${env.STAGE.toUpperCase()} Deployment completed with check failures\n\nAdvisory failures:\n${advisoryText}\n\nJenkins Build: <${env.BUILD_URL}|${env.BUILD_NUMBER}>\nCommit Hash: <${env.GIT_URL.replaceFirst(/\.git$/, '')}/commit/${env.GIT_COMMIT}|${env.GIT_COMMIT}>")

    //     } else {
    //       slackSend(color: "good", message: "${env.STAGE.toUpperCase()} Deployment succeeded!\n\nJenkins Build: <${env.BUILD_URL}|${env.BUILD_NUMBER}>\nCommit Hash: <${env.GIT_URL.replaceFirst(/\.git$/, '')}/commit/${env.GIT_COMMIT}|${env.GIT_COMMIT}>")
    //     }
    //   }
    // }
    // failure {
    //   slackSend(color: "danger", message: "${env.STAGE.toUpperCase()} Deployment failed:\n\nJenkins Build: <${env.BUILD_URL}|${env.BUILD_NUMBER}>\nCommit Hash: ${env.GIT_COMMIT}")
    // }
    always {
      cleanWs(deleteDirs: true)
    }
  }
}
