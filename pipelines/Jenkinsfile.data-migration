import java.math.RoundingMode

pipeline {
  agent {
    kubernetes {
            yaml '''
apiVersion: v1
kind: Pod
metadata:
  name: demos-jenkins-agent
  labels:
    jenkins: "agent"
spec:
  nodeSelector:
    node-pool: "agent"
  serviceAccountName: jenkins-role
  containers:
  - name: python
    image: artifactory.cloud.cms.gov/docker/python:3.13-slim
    command:
    - sleep
    args:
    - infinity
    resources:
      requests:
        cpu: '1'
        memory: '2Gi'
        ephemeral-storage: "2Gi"
      limits:
        cpu: '2'
        memory: '8Gi'
        ephemeral-storage: "10Gi"
  - name: node
    image: 'artifactory.cloud.cms.gov/docker/node:24-alpine'
    command:
    - cat
    tty: true
    resources:
      requests:
        cpu: '750m'
        memory: '1Gi'
        ephemeral-storage: "2Gi"
      limits:
        cpu: '1500m'
        memory: '2Gi'
        ephemeral-storage: "10Gi"
  - name: aws-cli
    image: artifactory.cloud.cms.gov/docker/amazon/aws-cli:latest
    command:
    - sleep
    - 99999
    tty: true
    resources:
      requests:
        cpu: 200m
        memory: 256Mi
        ephemeral-storage: "1Gi"
      limits:
        cpu: 400m
        memory: 512Mi
        ephemeral-storage: "5Gi"
'''
      defaultContainer 'python'
      retries 2
    }
  }

  options {
    disableConcurrentBuilds(abortPrevious: true)
    buildDiscarder(logRotator(
      numToKeepStr: "5",
      artifactNumToKeepStr: "5"
  ))
}

environment {
  DEMOS_AWS_PWD = credentials('demos-prod-pgsql-db-pw')
}

parameters {
  booleanParam(name: 'RUN_DBT', defaultValue: false, description: 'Run DBT transformations')
  booleanParam(name: 'COPY_FILES_BETWEEN_BUCKETS', defaultValue: false, description: 'Copy files between buckets')
  booleanParam(name: 'COPY_DATA_BETWEEN_SCHEMAS', defaultValue: false, description: 'Copy data between schemas')
  booleanParam(name: 'TAKE_SNAPSHOT', defaultValue: false, description: 'Take a snapshot of the migration')
}

stages {
  stage('Confirm') {
    steps {
      script {
        def description = 'I understand that this will run against the PROD database and potentially delete data.'
        if (params.RUN_DBT) {
          description += '\n    - run DBT transformations'
        }
        if (params.COPY_FILES_BETWEEN_BUCKETS) {
          description += '\n    - copy files between PMDA and DEMOS S3 buckets'
        }
        if (params.COPY_DATA_BETWEEN_SCHEMAS) {
          description += '\n    - copy data between schemas'
        }
        if (params.TAKE_SNAPSHOT) {
          description += '\n    - take a snapshot of the migration'
        }

        def inputParams = [booleanParam(
              defaultValue: false, 
              description: description, 
              name: 'APPROVE_PIPELINE_RUN'
            )]

        def userInput = input(
          message: "Are you sure you want to run this pipeline?",
          submitter: 'database_approvers',
          submitterParameter: 'APPROVED_BY',
          parameters: inputParams
        )
        if (userInput.APPROVE_PIPELINE_RUN != true) {
          error("User did not confirm. Aborting pipeline.")
        }
      }
    }
  }
  stage('Install Python dependencies') {
    steps {
      script {
        sh """
        apt-get update
        apt-get install -y --no-install-recommends libpq-dev gcc python3-dev

        python -m venv /app/venv

        /app/venv/bin/pip install -r .devcontainer/python/requirements.txt

        /app/venv/bin/dbt --version
        """
      }
    }
  }

  stage("Test connectivity") {
    steps {
      script {
        dir("data/demos_data_tools") {
          sh """
          /app/venv/bin/python -c 'import duckdb_connection_manager as d
conn = d.create_duckdb_conn()
d.attach_db_to_duckdb_conn(conn, "demos-aws")
print(conn.sql("SHOW DATABASES").fetchall())
conn.close()
'
          """
          assumeRole(accountNumber: env.DEMOS_AWS_PROD_ACCOUNT_NUMBER)
        }
      }
    }
  }

  stage("Run the dbt project") {
    when {
      expression {
        return params.RUN_DBT
      }
    }
    steps {
      script {
        dir("data/migration/data_migration_rev_01") {
          sh """
          set -e
          mv profiles.yml.jenkins profiles.yml
          /app/venv/bin/dbt deps
          /app/venv/bin/dbt build --profiles-dir ./
          """
        }
      }
    }
  }

  stage("Copy files between buckets") {
    when {
      expression {
        return params.COPY_FILES_BETWEEN_BUCKETS
      }
    }
    steps {
      script {
        dir("data/demos_data_tools") {
          sh """
          set -e
          /app/venv/bin/python migrate_files.py demos-aws rev01
          """
        }
      }
    }
  }

  stage("Copy data between schemas") {
    when {
      expression {
        return params.COPY_DATA_BETWEEN_SCHEMAS
      }
    }
    steps {
      script {
        dir("data/demos_data_tools") {
          sh """
          set -e
          /app/venv/bin/python load_data_to_demos_app.py demos-aws rev01
          """
        }
      }
    }
  }

  stage("Take a snapshot of the migration") {
    when {
      expression {
        return params.TAKE_SNAPSHOT
      }
    }
    steps {
      script {
        dir("data/demos_data_tools") {
          sh """
          set -e
          /app/venv/bin/python snapshot_migration_schema.py demos-aws rev01
          """
        }
      }
    }
  }

}

post {
  always {
    cleanWs(deleteDirs: true)
  }
}
}
