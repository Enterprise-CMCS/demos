{
  "compilerOptions": {
    "jsx": "react",
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["es2020", "DOM"],
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "types": ["vitest/globals", "node"],
    "paths": {
      "components": ["./src/components/index.ts"],
      "components/*": ["./src/components/*"],
      "pages/*": ["./src/pages/*"],
      "hooks": ["./src/hooks/index.ts"],
      "hooks/*": ["./src/hooks/*"],
      "layout/*": ["./src/layout/*"],
      "mock-data": ["./src/mock-data/index.ts"],
      "mock-data/*": ["./src/mock-data/*"],
      "queries/*": ["./src/queries/*"],
      "icons": ["./src/components/icons/index.ts"],
      "dates": ["./src/components/application/dates/index.ts"],
      "tags/*": ["./src/tags/*"],
      "test-utils/*": ["./src/test-utils/*"],
      "util/*": ["./src/util/*"],
      "config/*": ["./src/config/*"],
      "fragments": ["./src/fragments/index.ts"],
      "router/*": ["./src/router/*"],
      "demos-server": ["../server/src/types.ts"],
      "demos-server-constants": ["../server/src/constants.ts"]
    }
  },
  "exclude": ["node_modules"],
  "include": ["src/**/*", "types", "vitest.setup.ts"]
}
